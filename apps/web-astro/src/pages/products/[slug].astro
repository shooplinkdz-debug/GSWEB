---
import Layout from '../../layouts/Layout.astro';
import { formatDZD } from '../../utils/format';

const { slug } = Astro.params;
const API_URL = process.env.API_URL || 'http://localhost:4000';

let product: any = null;
let notFound = false;

try {
  const res = await fetch(`${API_URL}/api/products/${slug}`);
  if (res.ok) {
    product = await res.json();
  } else {
    notFound = true;
  }
} catch (err) {
  notFound = true;
}

// Fallback mock product matching slug if API not seeded
if (notFound || !product) {
  product = {
    id: 101,
    name: slug ? slug.replace(/-/g, ' ').toUpperCase() : "Produit Marketplace Algérie",
    slug: slug || "produit-marketplace",
    price: 4900,
    original_price: 6200,
    discount: "-20%",
    rating: 4.8,
    reviews_count: 142,
    sku: "MBA-SKU-9021",
    vendor_name: "TechDZ Store",
    category_name: "Électronique",
    description: "Produit de haute qualité sélectionné par nos vendeurs partenaires MBA. Livré sous 24h à 48h dans les 58 Wilayas d'Algérie avec paiement à la livraison.",
    stock: 15,
    image_url: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80"
  };
  notFound = false;
}
---

<Layout title={product ? product.name : 'Détail Produit'}>
  <nav class="flex items-center text-xs font-semibold text-slate-500 mb-6 gap-2">
    <a href="/" class="hover:text-emerald-800">Accueil</a>
    <span>&rsaquo;</span>
    <a href="/catalog" class="hover:text-emerald-800">Catalogue</a>
    <span>&rsaquo;</span>
    <span class="text-slate-800 line-clamp-1">{product.name}</span>
  </nav>

  <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xs overflow-hidden p-6 sm:p-10 grid grid-cols-1 md:grid-cols-2 gap-10">

    <!-- Image & Wishlist -->
    <div class="relative bg-slate-50 rounded-2xl overflow-hidden min-h-[340px] p-6 flex items-center justify-center border border-slate-100">
      <span class="absolute top-4 left-4 bg-emerald-800 text-amber-300 font-black text-xs px-2.5 py-1 rounded-lg z-10">
        {product.discount || '-15%'}
      </span>

      <button
        onclick={`toggleWishlist(${JSON.stringify({ id: product.id, name: product.name, price: product.price, image_url: product.image_url, slug: product.slug })})`}
        class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white text-slate-400 hover:text-red-500 flex items-center justify-center shadow-xs transition z-10"
        title="Ajouter aux favoris"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
      </button>

      <img
        src={product.image_url || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30'}
        alt={product.name}
        class="max-h-80 object-contain"
      />
    </div>

    <!-- Details Container -->
    <div class="flex flex-col justify-between space-y-6">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-[11px] font-bold bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md">SKU: {product.sku || 'MBA-1002'}</span>
          <span class="text-[11px] font-bold bg-emerald-50 text-emerald-800 px-2.5 py-1 rounded-md border border-emerald-200">
            🏪 {product.vendor_name || 'Boutique certifiée MBA'}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 leading-tight mb-2">{product.name}</h1>

        <div class="flex items-center gap-2 text-xs font-bold text-amber-500 mb-4">
          <span>★ {product.rating || '4.8'}</span>
          <span class="text-slate-400">({product.reviews_count || '120'} avis clients vérifiés)</span>
        </div>

        <div class="mb-6 pb-6 border-b border-slate-100">
          <div class="flex items-baseline gap-3 mb-2">
            <span class="text-3xl font-black text-emerald-900">
              {formatDZD(product.price)}
            </span>
            {product.original_price && (
              <span class="text-sm text-slate-400 line-through">
                {formatDZD(product.original_price)}
              </span>
            )}
          </div>
          <div class="flex items-center gap-2 text-xs font-semibold">
            <span class={`px-2.5 py-0.5 rounded-full ${product.stock > 0 ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}`}>
              {product.stock > 0 ? `En stock (${product.stock} disponibles)` : 'En rupture'}
            </span>
            <span class="text-slate-500">• Prix en Dinars Algériens (DZD)</span>
          </div>
        </div>

        <div>
          <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Description du produit</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            {product.description || 'Description produit sous garantie MBA Marketplace.'}
          </p>
        </div>
      </div>

      <!-- Actions -->
      <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200/80 space-y-4">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-slate-800">Quantité</label>
          <div class="flex items-center border border-slate-300 rounded-xl bg-white overflow-hidden">
            <button id="qty-minus" class="px-3 py-1 text-slate-600 hover:bg-slate-100 font-bold">-</button>
            <input id="qty-input" type="number" value="1" min="1" max={product.stock || 1} class="w-12 text-center text-xs font-bold border-none outline-none" />
            <button id="qty-plus" class="px-3 py-1 text-slate-600 hover:bg-slate-100 font-bold">+</button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <button
            id="add-cart-btn"
            disabled={product.stock <= 0}
            class="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 rounded-xl transition text-xs flex items-center justify-center gap-2"
          >
            <span>🛒 Ajouter au panier</span>
          </button>

          <button
            id="buy-now-btn"
            disabled={product.stock <= 0}
            class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-3 rounded-xl transition text-xs flex items-center justify-center gap-2 shadow-xs"
          >
            <span>⚡ Acheter maintenant</span>
          </button>
        </div>
      </div>

    </div>
  </div>

  <script id="product-detail-script" data-product={JSON.stringify(product)}>
    const minusBtn = document.getElementById('qty-minus');
    const plusBtn = document.getElementById('qty-plus');
    const qtyInput = document.getElementById('qty-input');
    const addBtn = document.getElementById('add-cart-btn');
    const buyBtn = document.getElementById('buy-now-btn');

    minusBtn?.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 1;
      if (val > 1) qtyInput.value = val - 1;
    });

    plusBtn?.addEventListener('click', () => {
      let val = parseInt(qtyInput.value) || 1;
      qtyInput.value = val + 1;
    });

    function addCurrentToCart() {
      const prodData = JSON.parse(document.getElementById('product-detail-script').getAttribute('data-product') || '{}');
      const qty = parseInt(qtyInput.value) || 1;
      if (!prodData.id) return;

      const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
      const existingIndex = cart.findIndex((item) => item.id === prodData.id);

      if (existingIndex > -1) {
        cart[existingIndex].quantity += qty;
      } else {
        cart.push({
          id: prodData.id,
          name: prodData.name,
          price: prodData.price,
          image_url: prodData.image_url,
          slug: prodData.slug,
          vendor_name: prodData.vendor_name || 'Boutique certifiée MBA',
          quantity: qty
        });
      }

      localStorage.setItem('mba_cart', JSON.stringify(cart));
      if (window.updateBadges) window.updateBadges();
    }

    addBtn?.addEventListener('click', () => {
      addCurrentToCart();
      alert('Produit ajouté au panier !');
    });

    buyBtn?.addEventListener('click', () => {
      addCurrentToCart();
      window.location.href = '/checkout';
    });
  </script>
</Layout>
