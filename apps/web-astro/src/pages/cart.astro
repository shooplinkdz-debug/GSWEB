---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mon Panier">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <h1 class="text-3xl font-black text-slate-900 mb-2">Votre Panier d'Achats</h1>
      <p class="text-slate-600 text-sm">Vérifiez les articles sélectionnés avant de finaliser votre commande.</p>
    </div>

    <!-- Empty State -->
    <div id="empty-cart-view" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 shadow-sm">
      <div class="text-5xl mb-4">🛒</div>
      <h2 class="text-xl font-bold text-slate-800 mb-2">Votre panier est vide</h2>
      <p class="text-slate-500 text-sm mb-6">Explorez notre catalogue pour ajouter des articles.</p>
      <a href="/catalog" class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-xl transition shadow">
        Explorer le catalogue
      </a>
    </div>

    <!-- Cart Items View -->
    <div id="cart-content-view" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Items List -->
      <div class="lg:col-span-2 space-y-4" id="cart-items-container">
        <!-- JS populated -->
      </div>

      <!-- Summary Card -->
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm h-fit space-y-6">
        <h2 class="text-xl font-black text-slate-900 border-b border-slate-100 pb-4">Résumé de commande</h2>

        <div class="space-y-3 text-sm">
          <div class="flex justify-between text-slate-600">
            <span>Sous-total articles :</span>
            <span id="summary-subtotal" class="font-bold text-slate-900">0 DZD</span>
          </div>
          <div class="flex justify-between text-slate-600">
            <span>Frais de livraison estimés :</span>
            <span class="text-emerald-600 font-bold">Calculés au paiement</span>
          </div>
        </div>

        <div class="border-t border-slate-200 pt-4 flex justify-between items-baseline">
          <span class="text-lg font-black text-slate-900">Total :</span>
          <span id="summary-total" class="text-2xl font-black text-emerald-600">0 DZD</span>
        </div>

        <a
          href="/checkout"
          class="block text-center w-full bg-emerald-600 hover:bg-emerald-500 text-white font-black py-3.5 rounded-xl transition shadow text-base"
        >
          Valider et Commander &rarr;
        </a>

        <a
          href="/catalog"
          class="block text-center w-full text-slate-600 hover:text-slate-900 text-xs font-semibold"
        >
          &larr; Continuer mes achats
        </a>
      </div>
    </div>
  </div>

  <script id="cart-page-script">
    function formatDZDJs(amount) {
      const numeric = typeof amount === 'string' ? parseFloat(amount) : amount;
      if (isNaN(numeric)) return '0 DZD';
      return new Intl.NumberFormat('fr-DZ', {
        maximumFractionDigits: 2,
        minimumFractionDigits: 0,
      }).format(numeric) + ' DZD';
    }

    function renderCart() {
      const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
      const emptyView = document.getElementById('empty-cart-view');
      const contentView = document.getElementById('cart-content-view');
      const itemsContainer = document.getElementById('cart-items-container');
      const subtotalEl = document.getElementById('summary-subtotal');
      const totalEl = document.getElementById('summary-total');

      if (!cart || cart.length === 0) {
        emptyView?.classList.remove('hidden');
        contentView?.classList.add('hidden');
        return;
      }

      emptyView?.classList.add('hidden');
      contentView?.classList.remove('hidden');

      if (itemsContainer) {
        itemsContainer.innerHTML = '';
        let total = 0;

        cart.forEach((item, index) => {
          const itemTotal = (parseFloat(item.price) || 0) * (item.quantity || 1);
          total += itemTotal;

          const itemEl = document.createElement('div');
          itemEl.className = 'bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center gap-4 justify-between';

          itemEl.innerHTML = `
            <div class="flex items-center gap-4 w-full sm:w-auto">
              <img src="${item.image_url || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30'}" alt="${item.name}" class="w-16 h-16 object-cover rounded-xl bg-slate-100" />
              <div>
                <a href="/products/${item.slug}" class="font-bold text-slate-900 hover:text-emerald-600 transition block text-base">${item.name}</a>
                <span class="text-emerald-600 font-extrabold text-sm">${formatDZDJs(item.price)} u.</span>
              </div>
            </div>

            <div class="flex items-center gap-6 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 pt-3 sm:pt-0 border-slate-100">
              <div class="flex items-center border border-slate-300 rounded-xl bg-slate-50 overflow-hidden">
                <button onclick="changeQty(${index}, -1)" class="px-3 py-1 font-bold text-slate-600 hover:bg-slate-200">-</button>
                <span class="px-3 text-sm font-bold">${item.quantity}</span>
                <button onclick="changeQty(${index}, 1)" class="px-3 py-1 font-bold text-slate-600 hover:bg-slate-200">+</button>
              </div>

              <span class="font-black text-slate-900 text-base">${formatDZDJs(itemTotal)}</span>

              <button onclick="removeItem(${index})" class="text-red-500 hover:text-red-700 p-1 font-bold text-xs">
                🗑️
              </button>
            </div>
          `;

          itemsContainer.appendChild(itemEl);
        });

        if (subtotalEl) subtotalEl.textContent = formatDZDJs(total);
        if (totalEl) totalEl.textContent = formatDZDJs(total);
      }
    }

    function changeQty(index, delta) {
      const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
      if (cart[index]) {
        cart[index].quantity += delta;
        if (cart[index].quantity <= 0) {
          cart.splice(index, 1);
        }
        localStorage.setItem('mba_cart', JSON.stringify(cart));
        if (window.updateCartBadge) window.updateCartBadge();
        renderCart();
      }
    }

    function removeItem(index) {
      const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
      if (cart[index]) {
        cart.splice(index, 1);
        localStorage.setItem('mba_cart', JSON.stringify(cart));
        if (window.updateCartBadge) window.updateCartBadge();
        renderCart();
      }
    }

    window.changeQty = changeQty;
    window.removeItem = removeItem;

    document.addEventListener('DOMContentLoaded', renderCart);
  </script>
</Layout>
