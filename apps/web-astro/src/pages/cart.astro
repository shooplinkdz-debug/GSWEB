---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panier et Paiement">
  <div class="max-w-2xl mx-auto bg-white p-8 rounded-2xl shadow-sm border border-slate-200">
    <h1 class="text-2xl font-bold mb-6 text-slate-800">Votre Panier</h1>

    <div class="divide-y divide-slate-100 mb-6">
      <div class="py-3 flex justify-between items-center">
        <div>
          <h2 class="font-semibold text-slate-800">Smartphone Pro Max</h2>
          <p class="text-sm text-slate-500">Quantité : 1</p>
        </div>
        <span class="font-bold text-slate-900">999.99 €</span>
      </div>
    </div>

    <div class="border-t border-slate-200 pt-4 mb-6 flex justify-between items-center font-bold text-lg">
      <span>Total :</span>
      <span class="text-indigo-600">999.99 €</span>
    </div>

    <form class="space-y-4">
      <h2 class="text-lg font-semibold text-slate-800 pt-2 border-t">Informations de livraison</h2>
      <input type="text" placeholder="Nom complet" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />
      <input type="email" placeholder="Adresse email" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />
      <textarea placeholder="Adresse de livraison" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"></textarea>

      <h2 class="text-lg font-semibold text-slate-800 pt-2 border-t">Paiement par Carte (Mode Test)</h2>
      <input type="text" placeholder="Numéro de carte de test (ex: 4242 4242 4242 4242)" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" />

      <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl transition shadow">
        Valider et Payez en mode test
      </button>
    </form>
  </div>
</Layout>
