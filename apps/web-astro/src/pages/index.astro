---
import Layout from '../layouts/Layout.astro';
import { formatDZD } from '../utils/format';

const API_URL = process.env.API_URL || 'http://localhost:4000';

let products: any[] = [];
let vendors: any[] = [];
let apiError = false;

try {
  const prodRes = await fetch(`${API_URL}/api/products`);
  if (prodRes.ok) {
    const data = await prodRes.json();
    products = Array.isArray(data) ? data : (data.items || []);
  } else {
    apiError = true;
  }
} catch (err) {
  apiError = true;
}

try {
  const vendRes = await fetch(`${API_URL}/api/vendors`);
  if (vendRes.ok) {
    vendors = await vendRes.json();
  }
} catch (err) {
  // Silent catch
}

// Default fallback items matching reference image if API empty or down
const samplePromos = products.length > 0 ? products.slice(0, 5) : [
  {
    id: 1,
    name: "Écouteurs sans fil Bluetooth Pro",
    slug: "ecouteurs-sans-fil-bluetooth-pro",
    price: 3900,
    original_price: 5200,
    discount: "-25%",
    rating: 4.7,
    reviews_count: 342,
    vendor_name: "TechDZ Store",
    image_url: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=500&auto=format&fit=crop&q=80",
    stock: 25
  },
  {
    id: 2,
    name: "Mini blender portable recharge USB",
    slug: "mini-blender-portable-usb",
    price: 4500,
    original_price: 5500,
    discount: "-18%",
    rating: 4.6,
    reviews_count: 189,
    vendor_name: "Maison & Cuisine DZ",
    image_url: "https://images.unsplash.com/photo-1570222094114-d054a817e56b?w=500&auto=format&fit=crop&q=80",
    stock: 12
  },
  {
    id: 3,
    name: "Montre connectée Smartwatch AMOLED",
    slug: "montre-connectee-smartwatch-amoled",
    price: 6900,
    original_price: 8900,
    discount: "-22%",
    rating: 4.5,
    reviews_count: 276,
    vendor_name: "Tech World DZ",
    image_url: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=80",
    stock: 8
  },
  {
    id: 4,
    name: "Lampe LED de bureau tactile articulée",
    slug: "lampe-led-bureau-tactile",
    price: 2200,
    original_price: 3200,
    discount: "-30%",
    rating: 4.8,
    reviews_count: 521,
    vendor_name: "Home Light",
    image_url: "https://images.unsplash.com/photo-1534353473418-4cfa6c56fd38?w=500&auto=format&fit=crop&q=80",
    stock: 40
  },
  {
    id: 5,
    name: "Sac à dos étanche PC portable 15.6\"",
    slug: "sac-a-dos-etanche-pc-portable",
    price: 3500,
    original_price: 4100,
    discount: "-15%",
    rating: 4.6,
    reviews_count: 213,
    vendor_name: "UrbanStyle DZ",
    image_url: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&auto=format&fit=crop&q=80",
    stock: 18
  }
];

const popularCategories = [
  { name: "Électronique", slug: "electronique", icon: "💻", image: "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=300&auto=format&fit=crop&q=80" },
  { name: "Maison", slug: "maison", icon: "🛋️", image: "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=300&auto=format&fit=crop&q=80" },
  { name: "Mode", slug: "mode", icon: "👕", image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=300&auto=format&fit=crop&q=80" },
  { name: "Beauté", slug: "beaute", icon: "💄", image: "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=300&auto=format&fit=crop&q=80" },
  { name: "Auto & Moto", slug: "auto-moto", icon: "🚗", image: "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=300&auto=format&fit=crop&q=80" },
  { name: "Jardin", slug: "jardin", icon: "🌿", image: "https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=300&auto=format&fit=crop&q=80" },
  { name: "Sport", slug: "sport", icon: "🏋️", image: "https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=300&auto=format&fit=crop&q=80" },
  { name: "Enfants", slug: "enfants", icon: "🧸", image: "https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?w=300&auto=format&fit=crop&q=80" },
];

const sampleShops = vendors.length > 0 ? vendors : [
  {
    company_name: "TechDZ Store",
    slug: "techdz-store",
    category: "Électronique & High-Tech",
    rating: 4.8,
    reviews: "1.2k avis",
    banner: "https://images.unsplash.com/photo-1526738549149-8e07eca6c147?w=600&auto=format&fit=crop&q=80"
  },
  {
    company_name: "Maison & Cuisine DZ",
    slug: "maison-cuisine-dz",
    category: "Équipement maison & cuisine",
    rating: 4.7,
    reviews: "856 avis",
    banner: "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=600&auto=format&fit=crop&q=80"
  },
  {
    company_name: "Fashion Algérie",
    slug: "fashion-algerie",
    category: "Mode homme & femme",
    rating: 4.6,
    reviews: "642 avis",
    banner: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600&auto=format&fit=crop&q=80"
  }
];
---

<Layout title="Accueil">

  <!-- 1. Hero Commercial Banner -->
  <section class="relative bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 text-white rounded-3xl p-6 sm:p-10 mb-8 shadow-xl overflow-hidden border border-emerald-800/80">
    <!-- Subtle Background Pattern -->
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#34d399_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

      <!-- Banner Content -->
      <div class="lg:col-span-8 space-y-4">
        <div class="inline-flex items-center gap-2 bg-emerald-800/80 border border-amber-400/40 px-3 py-1 rounded-full text-xs font-bold text-amber-300">
          <span>🇩🇿 100% Algérie</span>
          <span>•</span>
          <span>Des milliers de vendeurs certifiés</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
          Tout ce qu'il vous faut,<br/>
          <span class="text-amber-400">au même endroit.</span>
        </h1>

        <p class="text-emerald-100 text-sm sm:text-base max-w-xl leading-relaxed">
          Découvrez des milliers de produits auprès de vendeurs algériens indépendants. Livraison rapide dans les 58 Wilayas et paiement en espèces à la livraison.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="/catalog" class="bg-amber-400 hover:bg-amber-300 text-emerald-950 font-black px-6 py-3.5 rounded-xl shadow-lg transition flex items-center gap-2 text-sm group">
            <span>Découvrir les produits</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/vendors" class="bg-emerald-800/80 hover:bg-emerald-800 text-white font-bold px-5 py-3.5 rounded-xl border border-emerald-700 transition text-sm">
            Toutes les boutiques
          </a>
        </div>
      </div>

      <!-- Reassurance Cards Side Grid -->
      <div class="lg:col-span-4 space-y-3 hidden lg:block">

        <div class="p-4 bg-emerald-900/80 backdrop-blur-md rounded-2xl border border-emerald-700/60 flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-amber-400/20 text-amber-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <div>
            <h4 class="font-bold text-white text-sm">Vendeurs indépendants</h4>
            <p class="text-emerald-200 text-xs">Soutenez les commerçants locaux</p>
          </div>
        </div>

        <div class="p-4 bg-emerald-900/80 backdrop-blur-md rounded-2xl border border-emerald-700/60 flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-amber-400/20 text-amber-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4H6a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-2m-4-1v8m0 0l3-3m-3 3L9 8"/></svg>
          </div>
          <div>
            <h4 class="font-bold text-white text-sm">Livraison selon votre wilaya</h4>
            <p class="text-emerald-200 text-xs">A domicile ou au bureau de livraison</p>
          </div>
        </div>

        <div class="p-4 bg-emerald-900/80 backdrop-blur-md rounded-2xl border border-emerald-700/60 flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-xl bg-amber-400/20 text-amber-400 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <div>
            <h4 class="font-bold text-white text-sm">Prix transparents</h4>
            <p class="text-emerald-200 text-xs">Pas de frais cachés, paiement DZD</p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- 2. Reassurance Horizontal Strip -->
  <section class="bg-white rounded-2xl p-4 sm:p-6 shadow-xs border border-slate-200/80 mb-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 divide-y md:divide-y-0 md:divide-x rtl:md:divide-x-reverse divide-slate-100">

      <div class="flex items-center gap-4 pt-2 md:pt-0">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <div>
          <h4 class="font-bold text-slate-900 text-sm">Boutiques algériennes</h4>
          <p class="text-slate-500 text-xs">Des vendeurs passionnés et locaux</p>
        </div>
      </div>

      <div class="flex items-center gap-4 pt-4 md:pt-0 md:pl-6 rtl:md:pr-6">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
        </div>
        <div>
          <h4 class="font-bold text-slate-900 text-sm">Suivi de commande</h4>
          <p class="text-slate-500 text-xs">Restez informé à chaque étape</p>
        </div>
      </div>

      <div class="flex items-center gap-4 pt-4 md:pt-0 md:pl-6 rtl:md:pr-6">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-800 flex items-center justify-center shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
        <div>
          <h4 class="font-bold text-slate-900 text-sm">Assistance client</h4>
          <p class="text-slate-500 text-xs">Notre équipe est là pour vous aider</p>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. Popular Categories Grid -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
        <span>📦</span>
        <span>Catégories populaires</span>
      </h2>
      <a href="/catalog" class="text-emerald-800 hover:text-emerald-900 font-bold text-xs flex items-center gap-1 group">
        <span>Voir toutes les catégories</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 sm:gap-4">
      {popularCategories.map(cat => (
        <a href={`/catalog?category=${cat.slug}`} class="bg-white hover:bg-emerald-50/50 p-3 rounded-2xl border border-slate-200/80 hover:border-emerald-500/50 transition text-center shadow-xs group">
          <div class="w-12 h-12 mx-auto mb-2 rounded-xl bg-slate-100 group-hover:bg-emerald-100/80 flex items-center justify-center text-2xl transition">
            {cat.icon}
          </div>
          <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-900 block truncate">
            {cat.name}
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- 4. Best Deals & Offers -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
        <span>🔥</span>
        <span>Les meilleures offres</span>
      </h2>
      <a href="/catalog?offers=true" class="text-emerald-800 hover:text-emerald-900 font-bold text-xs flex items-center gap-1 group">
        <span>Voir toutes les offres</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
      {samplePromos.map(item => (
        <div class="bg-white rounded-2xl border border-slate-200/80 hover:shadow-md transition overflow-hidden flex flex-col justify-between group relative">

          <!-- Promo Tag & Wishlist Button -->
          <div class="relative bg-slate-50 aspect-square overflow-hidden p-3 flex items-center justify-center">
            <span class="absolute top-3 left-3 bg-emerald-800 text-amber-300 font-black text-[11px] px-2 py-0.5 rounded-md z-10">
              {item.discount || '-20%'}
            </span>
            <button
              onclick={`toggleWishlist(${JSON.stringify({ id: item.id, name: item.name, price: item.price, image_url: item.image_url, slug: item.slug })})`}
              class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-slate-400 hover:text-red-500 flex items-center justify-center shadow-xs transition z-10"
              title="Ajouter aux favoris"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
            </button>
            <img
              src={item.image_url || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30'}
              alt={item.name}
              class="max-h-full object-contain group-hover:scale-105 transition duration-300"
            />
          </div>

          <!-- Item Details -->
          <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
            <div>
              <a href={`/products/${item.slug}`} class="font-bold text-slate-800 text-sm hover:text-emerald-800 line-clamp-2 leading-snug">
                {item.name}
              </a>

              <div class="flex items-center gap-1 text-[11px] text-amber-500 font-bold mt-1">
                <span>★</span>
                <span>{item.rating || '4.7'}</span>
                <span class="text-slate-400 font-normal">({item.reviews_count || '120'})</span>
              </div>
            </div>

            <div>
              <div class="flex items-baseline gap-2">
                <span class="font-extrabold text-emerald-900 text-base">
                  {formatDZD(item.price)}
                </span>
                {item.original_price && (
                  <span class="text-xs text-slate-400 line-through">
                    {formatDZD(item.original_price)}
                  </span>
                )}
              </div>

              <div class="text-[11px] text-slate-500 font-medium truncate mt-1">
                {item.vendor_name || 'Boutique certifiée'}
              </div>

              <div class="flex items-center gap-1 text-[10px] text-emerald-700 font-bold mt-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
                <span>Livraison disponible</span>
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>
  </section>

  <!-- 5. Recommended Vendors / Boutiques à découvrir -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
        <span>🏪</span>
        <span>Boutiques à découvrir</span>
      </h2>
      <a href="/vendors" class="text-emerald-800 hover:text-emerald-900 font-bold text-xs flex items-center gap-1 group">
        <span>Voir toutes les boutiques</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sampleShops.map(shop => (
        <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-md transition">
          <div class="h-28 bg-slate-200 relative overflow-hidden">
            <img src={shop.banner} alt={shop.company_name} class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent"></div>
          </div>

          <div class="p-5 -mt-6 relative z-10 flex items-start gap-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-900 border-2 border-white text-amber-400 font-black flex items-center justify-center text-lg shadow-md shrink-0">
              {shop.company_name.substring(0,2).toUpperCase()}
            </div>

            <div class="flex-1 min-w-0 pt-4">
              <h3 class="font-bold text-slate-900 text-base truncate">{shop.company_name}</h3>
              <p class="text-xs text-slate-500 truncate">{shop.category}</p>

              <div class="flex items-center gap-2 text-xs font-bold mt-1 text-slate-700">
                <span class="text-amber-500">★ {shop.rating}</span>
                <span class="text-slate-400">({shop.reviews})</span>
              </div>

              <div class="mt-4">
                <a href={`/vendors/${shop.slug}`} class="inline-block bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs px-4 py-2 rounded-xl transition">
                  Voir la boutique
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 6. Trends in Algeria / Tendances -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-extrabold text-slate-900 flex items-center gap-2">
        <span>📈</span>
        <span>Tendances en Algérie</span>
      </h2>
      <a href="/catalog" class="text-emerald-800 hover:text-emerald-900 font-bold text-xs flex items-center gap-1 group">
        <span>Voir toutes les tendances</span>
        <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {(products.length > 0 ? products : samplePromos).slice(0, 6).map((item: any) => (
        <div class="bg-white rounded-2xl border border-slate-200/80 p-3 hover:border-emerald-500/50 transition group flex flex-col justify-between">
          <div class="bg-slate-50 aspect-square rounded-xl overflow-hidden mb-3 p-2 flex items-center justify-center">
            <img
              src={item.image_url || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30'}
              alt={item.name}
              class="max-h-full object-contain group-hover:scale-105 transition duration-300"
            />
          </div>
          <div>
            <a href={`/products/${item.slug}`} class="font-bold text-slate-800 text-xs hover:text-emerald-800 line-clamp-1 block mb-1">
              {item.name}
            </a>
            <span class="font-extrabold text-emerald-900 text-sm block">
              {formatDZD(item.price)}
            </span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Wishlist Script -->
  <script is:inline>
    function toggleWishlist(product) {
      try {
        let wishlist = JSON.parse(localStorage.getItem('mba_wishlist') || '[]');
        const existsIndex = wishlist.findIndex(item => item.id === product.id);
        if (existsIndex > -1) {
          wishlist.splice(existsIndex, 1);
          alert('Produit retiré des favoris');
        } else {
          wishlist.push(product);
          alert('Produit ajouté à vos favoris ❤️');
        }
        localStorage.setItem('mba_wishlist', JSON.stringify(wishlist));
        if (window.updateBadges) window.updateBadges();
      } catch (e) {
        console.error(e);
      }
    }
  </script>

</Layout>
