---
import Layout from '../layouts/Layout.astro';
import { ALGERIAN_WILAYAS } from '../utils/format';
---

<Layout title="Tunnel de Commande">
  <div class="max-w-3xl mx-auto py-6">
    <div class="mb-6">
      <h1 class="text-2xl font-black text-slate-900 mb-1 flex items-center gap-2">
        <span>⚡</span>
        <span>Validation de Commande</span>
      </h1>
      <p class="text-slate-500 text-xs">Renseignez vos coordonnées de livraison et validez votre achat en toute sécurité.</p>
    </div>

    <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-xs space-y-6">

      <!-- Order Form -->
      <form id="checkout-form" class="space-y-6">

        <!-- Contact Info -->
        <div>
          <h2 class="text-base font-black text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>👤</span>
            <span>1. Coordonnées Client</span>
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Nom Complet *</label>
              <input
                type="text"
                id="customer-name"
                required
                placeholder="Ex: Karim Benali"
                class="w-full px-3.5 py-2.5 border rounded-xl text-xs border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Numéro de Téléphone *</label>
              <input
                type="tel"
                id="customer-phone"
                required
                placeholder="Ex: 0550 12 34 56"
                class="w-full px-3.5 py-2.5 border rounded-xl text-xs border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none"
              />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 mb-1">Adresse Email *</label>
              <input
                type="email"
                id="customer-email"
                required
                placeholder="karim@domaine.dz"
                class="w-full px-3.5 py-2.5 border rounded-xl text-xs border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none"
              />
            </div>
          </div>
        </div>

        <!-- Shipping Info -->
        <div>
          <h2 class="text-base font-black text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>📍</span>
            <span>2. Adresse de Livraison (58 Wilayas)</span>
          </h2>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Wilaya d'Algérie *</label>
              <select
                id="shipping-wilaya"
                required
                class="w-full px-3.5 py-2.5 border rounded-xl text-xs border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none"
              >
                <option value="">Sélectionnez votre wilaya</option>
                {ALGERIAN_WILAYAS.map((w) => (
                  <option value={w}>{w}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Commune & Adresse Détaillée *</label>
              <textarea
                id="shipping-address-detail"
                required
                rows="2"
                placeholder="Ex: Commune d'Alger Centre, Rue Didouche Mourad, N°12"
                class="w-full px-3.5 py-2.5 border rounded-xl text-xs border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Payment Mode -->
        <div>
          <h2 class="text-base font-black text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>💵</span>
            <span>3. Mode de Règlement</span>
          </h2>
          <div class="p-4 border rounded-2xl border-emerald-600 bg-emerald-50/60 flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-emerald-800 text-amber-300 flex items-center justify-center font-bold text-sm shrink-0">
              💵
            </div>
            <div>
              <span class="font-bold text-slate-900 text-xs block">Paiement à la livraison (Cash on Delivery)</span>
              <span class="text-[11px] text-slate-600">Vous vérifiez le colis et vous réglez en espèces (DZD) auprès du livreur.</span>
            </div>
          </div>
        </div>

        <!-- Order Summary Preview -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs space-y-2">
          <div class="flex justify-between font-bold text-slate-700">
            <span>Articles dans le panier :</span>
            <span id="preview-count">0</span>
          </div>
          <div class="flex justify-between font-black text-emerald-900 text-sm border-t border-slate-200 pt-2">
            <span>Montant Total :</span>
            <span id="preview-total">0 DA</span>
          </div>
        </div>

        <!-- Error Message Container -->
        <div id="checkout-error" class="hidden p-3 bg-red-50 border border-red-200 text-red-700 rounded-xl text-xs font-medium"></div>

        <!-- Submit Button -->
        <button
          type="submit"
          id="submit-order-btn"
          class="w-full bg-emerald-800 hover:bg-emerald-900 text-white font-black py-3.5 rounded-2xl transition shadow-xs text-sm flex items-center justify-center gap-2"
        >
          <span>Confirmer ma commande (Paiement à la livraison)</span>
          <span>&rarr;</span>
        </button>
      </form>

    </div>
  </div>

  <script is:inline>
    function updateCheckoutPreview() {
      const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
      const countEl = document.getElementById('preview-count');
      const totalEl = document.getElementById('preview-total');

      const count = cart.reduce((acc, i) => acc + (i.quantity || 1), 0);
      const total = cart.reduce((acc, i) => acc + ((parseFloat(i.price) || 0) * (i.quantity || 1)), 0);

      if (countEl) countEl.textContent = count;
      if (totalEl) totalEl.textContent = `${total} DA`;

      // Auto-fill logged in user info if available
      const userStr = localStorage.getItem('mba_user');
      if (userStr) {
        try {
          const user = JSON.parse(userStr);
          const nameInput = document.getElementById('customer-name');
          const emailInput = document.getElementById('customer-email');
          const phoneInput = document.getElementById('customer-phone');

          if (nameInput && !nameInput.value) nameInput.value = `${user.first_name || ''} ${user.last_name || ''}`.trim();
          if (emailInput && !emailInput.value) emailInput.value = user.email || '';
          if (phoneInput && !phoneInput.value) phoneInput.value = user.phone || localStorage.getItem('mba_user_phone') || '';
        } catch (e) {}
      }

      const savedWilaya = localStorage.getItem('mba_selected_wilaya');
      if (savedWilaya) {
        const wilayaSelect = document.getElementById('shipping-wilaya');
        if (wilayaSelect) wilayaSelect.value = savedWilaya;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateCheckoutPreview();

      const form = document.getElementById('checkout-form');
      const errorEl = document.getElementById('checkout-error');
      const submitBtn = document.getElementById('submit-order-btn');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl?.classList.add('hidden');

        const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
        if (!cart || cart.length === 0) {
          if (errorEl) {
            errorEl.textContent = 'Votre panier est vide. Veuillez ajouter des produits avant de commander.';
            errorEl.classList.remove('hidden');
          }
          return;
        }

        const name = document.getElementById('customer-name')?.value;
        const phone = document.getElementById('customer-phone')?.value;
        const email = document.getElementById('customer-email')?.value;
        const wilaya = document.getElementById('shipping-wilaya')?.value;
        const addressDetail = document.getElementById('shipping-address-detail')?.value;

        const fullAddress = `[Wilaya ${wilaya}] Tél: ${phone} - ${addressDetail}`;

        const items = cart.map((item) => ({
          product_id: item.id,
          quantity: item.quantity || 1,
        }));

        submitBtn.disabled = true;
        submitBtn.textContent = 'Traitement et enregistrement de la commande...';

        try {
          const payload = {
            customer_name: name,
            customer_email: email,
            shipping_address: fullAddress,
            items: items,
            test_card_number: '4242 4242 4242 4242',
          };

          const token = localStorage.getItem('mba_token');
          const headers = { 'Content-Type': 'application/json' };
          if (token) headers['Authorization'] = `Bearer ${token}`;

          const res = await fetch('/api/orders', {
            method: 'POST',
            headers: headers,
            body: JSON.stringify(payload),
          });

          const data = await res.json();

          if (res.ok) {
            localStorage.removeItem('mba_cart');
            if (window.updateBadges) window.updateBadges();

            const orderId = data.order?.id || data.order?.order_number || '1';
            window.location.href = `/orders/${orderId}`;
          } else {
            if (errorEl) {
              errorEl.textContent = data.error || 'Erreur lors de la validation de la commande.';
              errorEl.classList.remove('hidden');
            }
            submitBtn.disabled = false;
            submitBtn.textContent = 'Confirmer ma commande (Paiement à la livraison)';
          }
        } catch (err) {
          if (errorEl) {
            errorEl.textContent = 'Erreur réseau lors du traitement de la commande.';
            errorEl.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          submitBtn.textContent = 'Confirmer ma commande (Paiement à la livraison)';
        }
      });
    });
  </script>
</Layout>
