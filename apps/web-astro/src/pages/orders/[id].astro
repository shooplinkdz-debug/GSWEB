---
import Layout from '../../layouts/Layout.astro';
import { formatDZD } from '../../utils/format';

const { id } = Astro.params;
const API_URL = process.env.API_URL || 'http://localhost:3000';

let orderData: any = null;
let notFound = false;

try {
  const res = await fetch(`${API_URL}/api/orders/${id}`);
  if (res.ok) {
    orderData = await res.json();
  } else {
    notFound = true;
  }
} catch (err) {
  notFound = true;
}

const order = orderData?.order;
const items = orderData?.items || [];
---

<Layout title={order ? `Commande #${order.order_number}` : 'Commande non trouvée'}>
  {notFound || !order ? (
    <div class="text-center py-20 bg-white rounded-2xl border border-slate-200 p-8 max-w-xl mx-auto my-12">
      <div class="text-5xl mb-4">🔍</div>
      <h1 class="text-2xl font-bold text-slate-800 mb-2">Commande Introuvable</h1>
      <p class="text-slate-500 text-sm mb-6">Aucune commande correspondant à l'identifiant "{id}" n'a été trouvée.</p>
      <a href="/orders" class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-xl transition">
        &larr; Rechercher une autre commande
      </a>
    </div>
  ) : (
    <div class="max-w-4xl mx-auto">
      <div class="mb-6 flex items-center justify-between flex-wrap gap-4">
        <div>
          <nav class="flex items-center text-xs font-semibold text-slate-500 mb-2 gap-2">
            <a href="/" class="hover:text-emerald-600">Accueil</a>
            <span>&rsaquo;</span>
            <a href="/orders" class="hover:text-emerald-600">Suivi</a>
            <span>&rsaquo;</span>
            <span class="text-slate-800">#{order.order_number}</span>
          </nav>
          <h1 class="text-3xl font-black text-slate-900">Détail de Commande</h1>
          <p class="text-xs font-mono text-slate-500 mt-1">Numéro : {order.order_number}</p>
        </div>

        <div class="flex items-center gap-3">
          <span class="bg-emerald-100 text-emerald-800 font-extrabold text-xs px-3.5 py-1.5 rounded-full border border-emerald-200">
            ✓ Statut : {order.status === 'PAID' ? 'Validée & Confirmée' : order.status}
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <!-- Order Summary & Shipping Address -->
        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm md:col-span-1 space-y-4 text-sm">
          <h2 class="font-black text-slate-900 border-b pb-2">Informations de Livraison</h2>
          <div>
            <span class="block text-xs text-slate-500 font-medium">Destinataire :</span>
            <span class="font-bold text-slate-900">{order.customer_name}</span>
          </div>
          <div>
            <span class="block text-xs text-slate-500 font-medium">Email :</span>
            <span class="text-slate-800">{order.customer_email}</span>
          </div>
          <div>
            <span class="block text-xs text-slate-500 font-medium">Adresse & Wilaya :</span>
            <span class="text-slate-800 leading-tight block">{order.shipping_address}</span>
          </div>
          <div>
            <span class="block text-xs text-slate-500 font-medium">Mode de Paiement :</span>
            <span class="inline-block bg-slate-100 text-slate-800 text-xs font-semibold px-2 py-0.5 rounded mt-0.5">
              {order.payment_method || 'Cash on Delivery'}
            </span>
          </div>
        </div>

        <!-- Ordered Items Table -->
        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm md:col-span-2 space-y-6">
          <h2 class="font-black text-slate-900 border-b pb-2">Articles Commandés ({items.length})</h2>

          <div class="divide-y divide-slate-100">
            {items.map((item: any) => (
              <div class="py-3 flex justify-between items-center text-sm">
                <div>
                  <h3 class="font-bold text-slate-900">{item.product_name}</h3>
                  <p class="text-xs text-slate-500">Quantité : {item.quantity} x {formatDZD(item.unit_price)}</p>
                </div>
                <span class="font-black text-slate-900">{formatDZD(Number(item.unit_price) * item.quantity)}</span>
              </div>
            ))}
          </div>

          <div class="border-t border-slate-200 pt-4 flex justify-between items-baseline font-black text-lg">
            <span>Total Payé :</span>
            <span class="text-2xl text-emerald-600">{formatDZD(order.total_amount)}</span>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="/catalog" class="inline-block bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-3 rounded-xl transition text-sm shadow">
          &larr; Continuer mes achats
        </a>
      </div>
    </div>
  )}
</Layout>
