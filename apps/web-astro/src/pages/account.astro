---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mon Compte Client — MA BOUTIQUE ALGÉRIENNE">
  <div class="max-w-7xl mx-auto px-4 py-8 space-y-8">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-black text-slate-900">Espace Client & Historique des Commandes</h1>
        <p class="text-sm text-slate-500">Gérez votre profil, vos adresses et vos commandes en toute sécurité.</p>
      </div>
      <a href="/catalog" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold px-4 py-2 rounded-xl text-sm transition">
        Explorer le Catalogue
      </a>
    </div>

    <!-- AI Customer Assistant Widget -->
    <div class="bg-gradient-to-r from-emerald-900 to-slate-900 text-white p-6 rounded-2xl shadow-md space-y-4">
      <div class="flex items-center space-x-3 rtl:space-x-reverse">
        <span class="bg-amber-400 text-slate-900 text-xs font-black px-2.5 py-1 rounded-lg uppercase">Assistant IA MBA</span>
        <h2 class="text-lg font-bold">Posez vos questions sur la livraison, les produits et vos commandes</h2>
      </div>

      <div class="flex space-x-2 rtl:space-x-reverse">
        <input id="ai-input" type="text" placeholder="Ex: Quel est le délai de livraison à Constantine ?" class="flex-1 px-4 py-2.5 rounded-xl text-slate-900 text-sm border-0 focus:ring-2 focus:ring-amber-400" />
        <button id="ai-btn" class="bg-amber-400 hover:bg-amber-300 text-slate-900 font-extrabold px-5 py-2.5 rounded-xl text-sm transition">
          Demander
        </button>
      </div>
      <div id="ai-response" class="hidden text-sm bg-white/10 p-4 rounded-xl border border-white/10 leading-relaxed font-sans"></div>
    </div>
  </div>

  <script>
    const btn = document.getElementById('ai-btn');
    const input = document.getElementById('ai-input') as HTMLInputElement;
    const resp = document.getElementById('ai-response');

    if (btn && input && resp) {
      btn.addEventListener('click', async () => {
        const query = input.value.trim();
        if (!query) return;

        resp.classList.remove('hidden');
        resp.innerText = "L'assistant IA analyse les données en direct...";

        try {
          const res = await fetch('http://localhost:4000/api/ai/assistant', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: query, type: 'general' }),
          });

          if (res.ok) {
            const data = await res.json();
            resp.innerText = data.response;
          } else {
            resp.innerText = "Une erreur est survenue lors de la communication avec l'assistant.";
          }
        } catch (err) {
          resp.innerText = "Erreur de connexion au serveur d'intelligence artificielle.";
        }
      });
    }
  </script>
</Layout>
