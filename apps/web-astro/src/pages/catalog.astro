---
import Layout from '../layouts/Layout.astro';
import { formatDZD } from '../utils/format';

const API_URL = process.env.API_URL || 'http://localhost:3000';

let products = [];
let categories: string[] = [];
let errorMsg = '';

try {
  const res = await fetch(`${API_URL}/api/products`);
  if (res.ok) {
    products = await res.json();
    const catSet = new Set<string>();
    products.forEach((p: any) => {
      if (p.category_name) catSet.add(p.category_name);
    });
    categories = Array.from(catSet);
  } else {
    errorMsg = 'Impossible de charger le catalogue produits.';
  }
} catch (err) {
  errorMsg = 'Erreur de connexion au serveur API.';
}
---

<Layout title="Catalogue Produit">
  <div class="mb-8">
    <h1 class="text-3xl font-black text-slate-900 mb-2">Catalogue des Produits</h1>
    <p class="text-slate-600 text-sm">Découvrez nos articles disponibles avec livraison dans les 58 wilayas d'Algérie.</p>
  </div>

  <!-- Filter Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Recherche par mot-clé</label>
      <input
        type="text"
        id="search-input"
        placeholder="Ex: Smartphone, Casque..."
        class="w-full px-4 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none border-slate-300"
      />
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Catégorie</label>
      <select
        id="category-select"
        class="w-full px-4 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none border-slate-300"
      >
        <option value="">Toutes les catégories</option>
        {categories.map((c) => (
          <option value={c}>{c}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="block text-xs font-semibold text-slate-600 mb-1">Trier par</label>
      <select
        id="sort-select"
        class="w-full px-4 py-2 border rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none border-slate-300"
      >
        <option value="newest">Nouveautés d'abord</option>
        <option value="price-asc">Prix croissant</option>
        <option value="price-desc">Prix décroissant</option>
      </select>
    </div>
  </div>

  {errorMsg && (
    <div class="p-6 bg-red-50 border border-red-200 text-red-700 rounded-2xl mb-8 font-medium text-sm">
      ⚠️ {errorMsg}
    </div>
  )}

  {products.length === 0 && !errorMsg && (
    <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 p-8">
      <div class="text-4xl mb-4">📦</div>
      <h3 class="text-lg font-bold text-slate-800 mb-2">Aucun produit dans le catalogue</h3>
      <p class="text-slate-500 text-sm">Revenez plus tard pour découvrir nos futurs articles.</p>
    </div>
  )}

  <!-- Products Grid -->
  <div id="products-container" class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {products.map((p: any) => (
      <div
        class="product-card bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between"
        data-name={p.name.toLowerCase()}
        data-category={p.category_name || ''}
        data-price={p.price}
        data-id={p.id}
      >
        <div>
          <div class="relative bg-slate-100 h-52 overflow-hidden">
            <img
              src={p.image_url || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30'}
              alt={p.name}
              class="w-full h-full object-cover"
            />
            {p.category_name && (
              <span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-white text-xs font-semibold px-2.5 py-1 rounded-lg">
                {p.category_name}
              </span>
            )}
          </div>
          <div class="p-6">
            <a href={`/products/${p.slug}`} class="font-bold text-slate-900 text-lg hover:text-emerald-600 transition block mb-1 line-clamp-1">
              {p.name}
            </a>
            <p class="text-xs text-slate-500 line-clamp-2 mb-4 h-8">
              {p.description || 'Description non disponible pour cet article.'}
            </p>
            <div class="flex justify-between items-baseline mb-4">
              <span class="text-2xl font-black text-emerald-600">
                {formatDZD(p.price)}
              </span>
              <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${p.stock > 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700'}`}>
                {p.stock > 0 ? `En stock` : 'Rupture'}
              </span>
            </div>
          </div>
        </div>
        <div class="p-6 pt-0 flex gap-2">
          <a
            href={`/products/${p.slug}`}
            class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold py-2.5 rounded-xl transition text-sm"
          >
            Détails
          </a>
          <button
            onclick={`addToCart(${JSON.stringify({ id: p.id, name: p.name, price: p.price, image_url: p.image_url, slug: p.slug }).replace(/"/g, '&quot;')})`}
            class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl transition text-sm shadow"
          >
            Ajouter
          </button>
        </div>
      </div>
    ))}
  </div>

  <div id="no-match-msg" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 p-8">
    <div class="text-4xl mb-4">🔍</div>
    <h3 class="text-lg font-bold text-slate-800 mb-2">Aucun produit ne correspond à vos filtres</h3>
    <p class="text-slate-500 text-sm">Essayez de modifier votre mot-clé ou la catégorie sélectionnée.</p>
  </div>

  <script id="catalog-client-script">
    function filterProducts() {
      const searchVal = (document.getElementById('search-input')?.value || '').toLowerCase();
      const catVal = document.getElementById('category-select')?.value || '';
      const sortVal = document.getElementById('sort-select')?.value || 'newest';

      const cards = Array.from(document.querySelectorAll('.product-card'));
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const category = card.getAttribute('data-category') || '';

        const matchesSearch = !searchVal || name.includes(searchVal);
        const matchesCategory = !catVal || category === catVal;

        if (matchesSearch && matchesCategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      const container = document.getElementById('products-container');
      const noMatch = document.getElementById('no-match-msg');

      if (noMatch) {
        if (visibleCount === 0 && cards.length > 0) {
          noMatch.classList.remove('hidden');
        } else {
          noMatch.classList.add('hidden');
        }
      }

      // Sort
      if (container) {
        const sorted = cards.sort((a, b) => {
          const priceA = parseFloat(a.getAttribute('data-price') || '0');
          const priceB = parseFloat(b.getAttribute('data-price') || '0');
          const idA = parseInt(a.getAttribute('data-id') || '0');
          const idB = parseInt(b.getAttribute('data-id') || '0');

          if (sortVal === 'price-asc') return priceA - priceB;
          if (sortVal === 'price-desc') return priceB - priceA;
          return idB - idA; // newest
        });

        sorted.forEach((card) => container.appendChild(card));
      }
    }

    function addToCart(product) {
      try {
        const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
        const existingIndex = cart.findIndex((item) => item.id === product.id);

        if (existingIndex > -1) {
          cart[existingIndex].quantity += 1;
        } else {
          cart.push({ ...product, quantity: 1 });
        }

        localStorage.setItem('mba_cart', JSON.stringify(cart));
        if (window.updateCartBadge) window.updateCartBadge();
        alert(`"${product.name}" a été ajouté à votre panier !`);
      } catch (e) {
        console.error(e);
      }
    }

    document.getElementById('search-input')?.addEventListener('input', filterProducts);
    document.getElementById('category-select')?.addEventListener('change', filterProducts);
    document.getElementById('sort-select')?.addEventListener('change', filterProducts);
  </script>
</Layout>
