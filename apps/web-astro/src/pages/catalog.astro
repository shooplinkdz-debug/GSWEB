---
import Layout from '../layouts/Layout.astro';
import { formatDZD } from '../utils/format';

const API_URL = process.env.API_URL || 'http://localhost:4000';

let products: any[] = [];
let categories: string[] = [];
let errorMsg = '';

try {
  const res = await fetch(`${API_URL}/api/products`);
  if (res.ok) {
    const data = await res.json();
    products = Array.isArray(data) ? data : (data.items || []);
    const catSet = new Set<string>();
    products.forEach((p: any) => {
      if (p.category_name) catSet.add(p.category_name);
    });
    categories = Array.from(catSet);
  } else {
    errorMsg = 'Impossible de charger le catalogue produits.';
  }
} catch (err) {
  errorMsg = 'Erreur de connexion au serveur API.';
}

// Default fallback items if API database is not seeded
if (products.length === 0) {
  products = [
    { id: 1, name: "Écouteurs sans fil Bluetooth Pro", slug: "ecouteurs-sans-fil-bluetooth-pro", price: 3900, category_name: "Électronique", stock: 25, vendor_name: "TechDZ Store", image_url: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?w=500&auto=format&fit=crop&q=80" },
    { id: 2, name: "Mini blender portable recharge USB", slug: "mini-blender-portable-usb", price: 4500, category_name: "Maison", stock: 12, vendor_name: "Maison & Cuisine DZ", image_url: "https://images.unsplash.com/photo-1570222094114-d054a817e56b?w=500&auto=format&fit=crop&q=80" },
    { id: 3, name: "Montre connectée Smartwatch AMOLED", slug: "montre-connectee-smartwatch-amoled", price: 6900, category_name: "Électronique", stock: 8, vendor_name: "Tech World DZ", image_url: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=80" },
    { id: 4, name: "Lampe LED de bureau tactile articulée", slug: "lampe-led-bureau-tactile", price: 2200, category_name: "Maison", stock: 40, vendor_name: "Home Light", image_url: "https://images.unsplash.com/photo-1534353473418-4cfa6c56fd38?w=500&auto=format&fit=crop&q=80" },
    { id: 5, name: "Sac à dos étanche PC portable 15.6\"", slug: "sac-a-dos-etanche-pc-portable", price: 3500, category_name: "Mode", stock: 18, vendor_name: "UrbanStyle DZ", image_url: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&auto=format&fit=crop&q=80" }
  ];
  categories = ["Électronique", "Maison", "Mode", "Beauté", "Auto & Moto", "Jardin", "Sport", "Enfants"];
}
---

<Layout title="Catalogue Produit">
  <div class="mb-6">
    <h1 class="text-2xl font-black text-slate-900 mb-1 flex items-center gap-2">
      <span>🛒</span>
      <span>Catalogue des Produits</span>
    </h1>
    <p class="text-slate-500 text-xs">Découvrez nos articles certifiés avec livraison garantie dans les 58 wilayas d'Algérie.</p>
  </div>

  <!-- AI Assistant Widget Header -->
  <div class="bg-gradient-to-r from-emerald-950 via-emerald-900 to-emerald-950 text-white rounded-2xl p-4 shadow-sm mb-6 border border-emerald-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-400 text-slate-950 font-bold flex items-center justify-center text-xl shrink-0">
        🤖
      </div>
      <div>
        <h3 class="font-bold text-sm text-white">Assistant IA & Recommandations MBA</h3>
        <p class="text-xs text-emerald-200">Posez une question sur un produit ou demandez un conseil d'achat instantané !</p>
      </div>
    </div>
    <div class="flex w-full md:w-auto items-center gap-2">
      <input type="text" id="ai-input" placeholder="Ex: Quel téléphone a la meilleure batterie sous 30 000 DA ?" class="px-3.5 py-2 rounded-xl text-xs bg-slate-900/80 border border-emerald-700 text-white placeholder-slate-400 outline-none w-full md:w-72" />
      <button onclick="askAiAssistant()" class="bg-amber-400 hover:bg-amber-300 text-emerald-950 font-bold px-4 py-2 rounded-xl text-xs shrink-0 transition">
        Demander
      </button>
    </div>
  </div>

  <div id="ai-response" class="hidden bg-emerald-900/20 border border-emerald-700/50 p-4 rounded-2xl text-xs text-emerald-900 mb-6 space-y-1">
    <!-- AI answer box -->
  </div>

  <!-- Filter Bar -->
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs mb-8 grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Recherche par mot-clé</label>
      <input
        type="text"
        id="search-input"
        placeholder="Ex: Écouteurs, Blender..."
        class="w-full px-3.5 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-emerald-500 outline-none border-slate-300"
      />
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Catégorie</label>
      <select
        id="category-select"
        class="w-full px-3.5 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-emerald-500 outline-none border-slate-300"
      >
        <option value="">Toutes les catégories</option>
        {categories.map((c) => (
          <option value={c}>{c}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">Trier par</label>
      <select
        id="sort-select"
        class="w-full px-3.5 py-2 border rounded-xl text-xs focus:ring-2 focus:ring-emerald-500 outline-none border-slate-300"
      >
        <option value="newest">Nouveautés d'abord</option>
        <option value="price-asc">Prix croissant</option>
        <option value="price-desc">Prix décroissant</option>
      </select>
    </div>
  </div>

  <!-- Products Grid -->
  <div id="products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {products.map((p: any) => (
      <div
        class="product-card bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col justify-between group"
        data-name={p.name.toLowerCase()}
        data-category={p.category_name || ''}
        data-price={p.price}
        data-id={p.id}
      >
        <div>
          <div class="relative bg-slate-50 aspect-square overflow-hidden p-3 flex items-center justify-center">
            <img
              src={p.image_url || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30'}
              alt={p.name}
              class="max-h-full object-contain group-hover:scale-105 transition duration-300"
            />
            {p.category_name && (
              <span class="absolute top-3 left-3 bg-emerald-950/80 backdrop-blur-md text-amber-300 text-[10px] font-bold px-2.5 py-1 rounded-lg">
                {p.category_name}
              </span>
            )}
          </div>
          <div class="p-4">
            <a href={`/products/${p.slug}`} class="font-bold text-slate-800 text-sm hover:text-emerald-800 transition block mb-1 line-clamp-2 leading-snug">
              {p.name}
            </a>
            <p class="text-[11px] text-slate-500 line-clamp-2 mb-3 h-8">
              {p.description || 'Produit disponible en Algérie avec livraison rapide.'}
            </p>
            <div class="flex justify-between items-baseline mb-2">
              <span class="text-base font-black text-emerald-900">
                {formatDZD(p.price)}
              </span>
              <span class={`text-[10px] font-bold px-2 py-0.5 rounded ${p.stock > 0 ? 'bg-emerald-50 text-emerald-800' : 'bg-red-50 text-red-700'}`}>
                {p.stock > 0 ? `En stock` : 'Rupture'}
              </span>
            </div>
          </div>
        </div>
        <div class="p-4 pt-0 flex gap-2">
          <a
            href={`/products/${p.slug}`}
            class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold py-2 rounded-xl transition text-xs"
          >
            Détails
          </a>
          <button
            onclick={`addToCart(${JSON.stringify({ id: p.id, name: p.name, price: p.price, image_url: p.image_url, slug: p.slug }).replace(/"/g, '&quot;')})`}
            class="flex-1 bg-emerald-800 hover:bg-emerald-900 text-white font-bold py-2 rounded-xl transition text-xs shadow-xs"
          >
            Ajouter
          </button>
        </div>
      </div>
    ))}
  </div>

  <div id="no-match-msg" class="hidden text-center py-16 bg-white rounded-2xl border border-slate-200 p-8">
    <div class="text-4xl mb-4">🔍</div>
    <h3 class="text-lg font-bold text-slate-800 mb-2">Aucun produit ne correspond à vos filtres</h3>
    <p class="text-slate-500 text-xs">Essayez de modifier votre mot-clé ou la catégorie sélectionnée.</p>
  </div>

  <script is:inline>
    function filterProducts() {
      const searchVal = (document.getElementById('search-input')?.value || '').toLowerCase();
      const catVal = document.getElementById('category-select')?.value || '';
      const sortVal = document.getElementById('sort-select')?.value || 'newest';

      const cards = Array.from(document.querySelectorAll('.product-card'));
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const category = card.getAttribute('data-category') || '';

        const matchesSearch = !searchVal || name.includes(searchVal);
        const matchesCategory = !catVal || category === catVal;

        if (matchesSearch && matchesCategory) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      const container = document.getElementById('products-container');
      const noMatch = document.getElementById('no-match-msg');

      if (noMatch) {
        if (visibleCount === 0 && cards.length > 0) {
          noMatch.classList.remove('hidden');
        } else {
          noMatch.classList.add('hidden');
        }
      }

      if (container) {
        const sorted = cards.sort((a, b) => {
          const priceA = parseFloat(a.getAttribute('data-price') || '0');
          const priceB = parseFloat(b.getAttribute('data-price') || '0');
          const idA = parseInt(a.getAttribute('data-id') || '0');
          const idB = parseInt(b.getAttribute('data-id') || '0');

          if (sortVal === 'price-asc') return priceA - priceB;
          if (sortVal === 'price-desc') return priceB - priceA;
          return idB - idA;
        });

        sorted.forEach((card) => container.appendChild(card));
      }
    }

    function addToCart(product) {
      try {
        const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
        const existingIndex = cart.findIndex((item) => item.id === product.id);

        if (existingIndex > -1) {
          cart[existingIndex].quantity += 1;
        } else {
          cart.push({ ...product, quantity: 1 });
        }

        localStorage.setItem('mba_cart', JSON.stringify(cart));
        if (window.updateBadges) window.updateBadges();
        alert(`"${product.name}" a été ajouté à votre panier !`);
      } catch (e) {
        console.error(e);
      }
    }

    async function askAiAssistant() {
      const input = document.getElementById('ai-input').value.trim();
      const resBox = document.getElementById('ai-response');
      if (!input) return;

      resBox.classList.remove('hidden');
      resBox.innerHTML = '<span class="font-bold">Analyse par l\'assistant IA MBA...</span>';

      try {
        const res = await fetch('/api/ai/assistant', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt: input })
        });

        if (res.ok) {
          const data = await res.json();
          resBox.innerHTML = `<span class="font-bold text-amber-700 block mb-1">💡 Réponse IA :</span><p class="text-slate-800">${data.response || data.message || 'Voici nos meilleures recommandations selon vos critères.'}</p>`;
        } else {
          resBox.innerHTML = `<span class="font-bold text-amber-700 block mb-1">💡 Conseil IA :</span><p class="text-slate-800">Pour votre recherche "${input}", découvrez notre sélection certifiée d'appareils à haute autonomie et rapport qualité-prix sur le catalogue MBA !</p>`;
        }
      } catch (e) {
        resBox.innerHTML = `<span class="font-bold text-amber-700 block mb-1">💡 Conseil IA :</span><p class="text-slate-800">Pour votre recherche "${input}", découvrez notre sélection certifiée avec garantie livraison 58 wilayas.</p>`;
      }
    }

    document.getElementById('search-input')?.addEventListener('input', filterProducts);
    document.getElementById('category-select')?.addEventListener('change', filterProducts);
    document.getElementById('sort-select')?.addEventListener('change', filterProducts);
  </script>
</Layout>
