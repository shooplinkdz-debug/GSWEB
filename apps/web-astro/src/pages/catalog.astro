---
import Layout from '../layouts/Layout.astro';

const mockProducts = [
  { id: 1, name: 'Smartphone Pro Max', price: '999.99 €', image_url: 'https://images.unsplash.com/photo-1511707171634-5f897ff02aa9' },
  { id: 2, name: 'Casque Audio Sans Fil', price: '199.99 €', image_url: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e' },
  { id: 3, name: 'T-shirt Coton Bio', price: '29.99 €', image_url: 'https://images.unsplash.com/photo-1521572267360-ee0c2909d518' },
];
---

<Layout title="Catalogue Produit">
  <h1 class="text-3xl font-bold mb-8 text-slate-800">Nos Produits</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {mockProducts.map((p) => (
      <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition">
        <img src={p.image_url} alt={p.name} class="w-full h-48 object-cover" />
        <div class="p-6">
          <h2 class="text-xl font-bold mb-2 text-slate-800">{p.name}</h2>
          <p class="text-indigo-600 font-extrabold text-lg mb-4">{p.price}</p>
          <a href="/cart" class="block text-center w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg transition">
            Ajouter au panier
          </a>
        </div>
      </div>
    ))}
  </div>
</Layout>
