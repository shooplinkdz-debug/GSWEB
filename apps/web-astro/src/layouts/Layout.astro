---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Web Manager Store</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col">
    <header class="bg-indigo-900 text-white shadow-md">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold tracking-tight">WebManager Store</a>
        <nav class="space-x-6 flex items-center">
          <a href="/" class="hover:text-indigo-200">Accueil</a>
          <a href="/catalog" class="hover:text-indigo-200">Catalogue</a>
          <a href="/cart" class="bg-indigo-600 hover:bg-indigo-500 px-4 py-2 rounded-lg font-semibold transition">Panier</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-8">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 py-6 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <p>&copy; {new Date().getFullYear()} Web Manager. Tous droits réservés.</p>
      </div>
    </footer>
  </body>
</html>
