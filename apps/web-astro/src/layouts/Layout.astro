---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "MBA — Ma Boutique Algérienne Marketplace. Découvrez les meilleurs produits et boutiques en Algérie avec livraison 58 wilayas et paiement en DZD." } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — MBA Marketplace Algérie</title>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans min-h-screen flex flex-col antialiased">
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-50 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-4">
        <a href="/" class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500 flex items-center justify-center font-black text-xl text-slate-900 shadow">
            MBA
          </div>
          <div>
            <span class="text-xl font-bold tracking-tight text-white block">Ma Boutique Algérienne</span>
            <span class="text-xs text-emerald-400 block font-medium">Marketplace 100% Algérie (DZD)</span>
          </div>
        </a>

        <nav class="flex items-center space-x-1 sm:space-x-4 text-sm font-medium">
          <a href="/" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-200 hover:text-white transition">
            Accueil
          </a>
          <a href="/catalog" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-200 hover:text-white transition">
            Catalogue
          </a>
          <a href="/vendors" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-200 hover:text-white transition">
            Boutiques
          </a>
          <a href="/orders" class="px-3 py-2 rounded-lg hover:bg-slate-800 text-slate-200 hover:text-white transition">
            Suivi
          </a>
          <a href="/cart" class="relative flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold px-4 py-2 rounded-xl transition shadow">
            <span>Panier</span>
            <span id="cart-badge" class="bg-white text-emerald-700 text-xs font-black rounded-full w-5 h-5 flex items-center justify-center hidden">
              0
            </span>
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 py-8">
      <slot />
    </main>

    <footer class="bg-slate-900 text-slate-400 py-10 border-t border-slate-800 mt-12 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <div>
          <h3 class="text-white font-bold text-base mb-3">MBA — Ma Boutique Algérienne</h3>
          <p class="text-slate-400 text-xs leading-relaxed">
            La première plateforme e-commerce multi-vendeurs dédiée au marché algérien.
            Livraison dans les 58 Wilayas et paiements sécurisés en Dinars Algériens (DZD).
          </p>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-3">Navigation rapide</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/" class="hover:text-emerald-400 transition">Accueil</a></li>
            <li><a href="/catalog" class="hover:text-emerald-400 transition">Catalogue Produits</a></li>
            <li><a href="/vendors" class="hover:text-emerald-400 transition">Boutiques Partenaires</a></li>
            <li><a href="/orders" class="hover:text-emerald-400 transition">Suivre ma commande</a></li>
            <li><a href="/cart" class="hover:text-emerald-400 transition">Mon Panier</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-white font-semibold text-sm mb-3">Modes de Règlement</h4>
          <p class="text-xs text-slate-400 leading-relaxed mb-2">
            Paiement à la livraison (Cash on Delivery) disponible dans toutes les wilayas.
          </p>
          <div class="inline-block bg-slate-800 px-3 py-1.5 rounded-lg text-emerald-400 font-mono text-xs font-semibold">
            Monnaie : Dinars Algériens (DZD)
          </div>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 border-t border-slate-800 pt-6 text-center text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} MBA — Ma Boutique Algérienne. Tous droits réservés.</p>
      </div>
    </footer>

    <script id="cart-counter-script">
      function updateCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('mba_cart') || '[]');
          const count = cart.reduce((acc, item) => acc + (item.quantity || 1), 0);
          const badge = document.getElementById('cart-badge');
          if (badge) {
            if (count > 0) {
              badge.textContent = count;
              badge.classList.remove('hidden');
            } else {
              badge.classList.add('hidden');
            }
          }
        } catch (e) {
          console.error(e);
        }
      }
      document.addEventListener('DOMContentLoaded', updateCartBadge);
      window.addEventListener('storage', updateCartBadge);
      window.updateCartBadge = updateCartBadge;
    </script>
  </body>
</html>
