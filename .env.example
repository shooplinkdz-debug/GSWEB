# Global Environment Variables Example

# Server API Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=webmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/webmanager?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# AI Assistant Mock / Provider Key
AI_PROVIDER_API_KEY=mock_key_for_local_ai_assistant

# Google Sheets Synchronization (Optionnel / Optional)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id

# Public Web Site (Astro)
PUBLIC_API_URL=http://localhost:4000/api

# Nuxt Admin Portal
NUXT_PUBLIC_API_URL=http://localhost:4000/api
